{
  "name": "soumtok-ide",
  "productName": "Soumtok",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Soumtok",
    "email": "info@soumtok.com"
  },
  "homepage": "https://soumtok.com",
  "description": "Soumtok desktop IDE — Cursor-style editor signed into your Soumtok account",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "rebuild-native": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs",
    "soumtok-code:install": "node scripts/install-soumtok-code-host.mjs",
    "vscode:fork-bootstrap": "node vscode-fork/bootstrap.mjs",
    "installer:assets": "node scripts/generate-installer-assets.mjs",
    "pack:win": "node scripts/pack-win-all.mjs",
    "pack:mac": "npm run installer:assets && electron-builder --mac --x64 --arm64",
    "pack:linux": "node scripts/pack-linux-all.mjs",
    "pack:all": "npm run pack:win && npm run pack:linux",
    "release:sync": "node scripts/sync-release-manifest.mjs",
    "release:upload": "node scripts/upload-releases.mjs",
    "release:verify": "node scripts/publish-release.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.soumtok.ide",
    "productName": "Soumtok",
    "copyright": "Copyright © Soumtok",
    "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/monaco-editor/min/**/*",
      "node_modules/@xterm/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "extraResources": [
      { "from": "node_modules/monaco-editor/min", "to": "monaco" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "zip"],
      "publisherName": "Soumtok",
      "legalTrademarks": "Soumtok",
      "verifyUpdateCodeSignature": true,
      "signDlls": true,
      "signingHashAlgorithms": ["sha256"],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "title": "${productName} ${version}",
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 130, "y": 200, "type": "file" },
        { "x": 410, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "icon": "build/linux-icon.png",
      "artifactName": "${productName}-Setup-${version}-linux-${arch}.${ext}",
      "target": ["AppImage", "deb"],
      "maintainer": "Soumtok <info@soumtok.com>",
      "category": "Development",
      "synopsis": "AI-native IDE with agent, Tab, and terminal",
      "description": "Soumtok Desktop — Cursor-style editor signed into your Soumtok account."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "license": "build/license.rtf",
      "include": "build/installer.nsh",
      "shortcutName": "Soumtok",
      "uninstallDisplayName": "Soumtok",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": true,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.soumtok.com/desktop/"
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  }
}
