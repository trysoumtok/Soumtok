# Neon Postgres connection string (Dashboard → Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public URL of this app (use apex host in production — not www).
BETTER_AUTH_URL=http://localhost:5173

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URIs (Web client) — add every URL you use:
# http://localhost:5173/api/auth/callback/google
# https://soumtok.com/api/auth/callback/google
# Authorized JavaScript origins: http://localhost:5173 and https://soumtok.com
# Use soumtok.com (not www) as BETTER_AUTH_URL — www redirects to apex for OAuth cookies.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (sign-in / sign-up) — trysoumtok org → Settings → Developer settings → OAuth Apps
# Authorized callback URLs (add every host you use):
# http://localhost:5173/api/auth/callback/github
# https://soumtok.com/api/auth/callback/github
# Repo: https://github.com/trysoumtok/Soumtok
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App slug for repo access (install URL). Default soumtok — https://github.com/apps/soumtok
GITHUB_APP_SLUG=soumtok

# Bunny Storage (zone name + password from dash.bunny.net → Storage → FTP & API)
BUNNY_STORAGE_ZONE=soumtok-files
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_S3_ENDPOINT=https://de-s3.storage.bunnycdn.com

# Neon Auth (Console → Auth → Configuration). Email is sent via Neon compute + Purelymail.
NEON_AUTH_BASE_URL=

# Neon Function mail relay — deploy with `neon deploy --env .env`, then set NEON_MAIL_URL from
# `neon functions get mail` (invocation_url). Same secret as MAIL_FUNCTION_SECRET on the function.
NEON_MAIL_URL=
NEON_MAIL_SECRET=
MAIL_FUNCTION_SECRET=

# Purelymail SMTP — used by the Neon mail function and for local dev direct send
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=info@soumtok.com
SMTP_PASS=
SMTP_FROM=Soumtok <info@soumtok.com>

# Optional. Without this, phone codes are emailed to the account inbox until SMS is added.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Replicate — default stills (Flux 2 Max). Required for generate_image().
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Optional alias:
# REPLICATE_API_KEY=

# Optional Fal fallback (Flux Schnell) if Replicate is not set
# https://fal.ai/dashboard/keys
FAL_KEY=

# Platform coding keys — Studio uses these when a user has not added their own
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini — used to examine videos (and images) via examine_media()
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# PayHero / M-Pesa
PAYHERO_USERNAME=
PAYHERO_PASSWORD=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://soumtok.com/api/billing/mpesa/callback
PAYHERO_LIPWA_URL=
PAYHERO_BASIC_TOKEN=
MPESA_KES_PER_USD=130

# Local dev only: allow every model and skip trial token cap. Production must use 0.
SOUMTOK_OPEN_ACCESS=1

# Soumtok Desktop: API base (defaults to https://soumtok.com). Use local server while developing:
# Desktop IDE → Soumtok STUDIO API (not your project's Vite URL). Dev auto-detects when npm run dev runs in repo root.
# SOUMTOK_API=http://localhost:5173
# If your app also uses port 5173, stop it while using Desktop, or use production: SOUMTOK_API=https://soumtok.com
# Soumtok Desktop — auto-update feed + website download links (upload release/ contents here)
# SOUMTOK_UPDATE_URL=https://releases.soumtok.com/desktop/
# SOUMTOK_RELEASES_URL=https://releases.soumtok.com/desktop/
# Remote desktop control (also editable in data/desktop-control.json)
# DESKTOP_ADMIN_SECRET=change-me
# DESKTOP_LATEST_VERSION=0.1.0
# DESKTOP_MIN_VERSION=0.1.0
# DESKTOP_FORCE_UPDATE=0
# DESKTOP_DISABLED=0
# DESKTOP_DISABLED_MESSAGE=Soumtok Desktop is temporarily unavailable.
# SOUMTOK_CRASH_URL=
# Code signing — REQUIRED for public Windows/macOS releases (removes SmartScreen / Gatekeeper warnings)
# Windows: export your Authenticode cert as .pfx and set WIN_CSC_LINK before npm run pack:win
# WIN_CSC_LINK=E:/certs/soumtok-code-sign.pfx
# CSC_KEY_PASSWORD=
# macOS (optional on Windows host):
# CSC_LINK=path/to/certificate.pfx
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
